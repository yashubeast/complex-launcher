#!/usr/bin/env bash

CLASS="complex-launcher"
TERMINAL_CMD=(
  st -c "$CLASS" -g "100x80"
)

# find the first matching window
WINDOW_ID="$(xdotool search --class "^${CLASS}$" 2>/dev/null | head -n1)"

if [[ -z "$WINDOW_ID" ]]; then
  # doesn't exist -> launch it
  "${TERMINAL_CMD[@]}" &

elif xdotool search --onlyvisible --class "^${CLASS}$" 2>/dev/null | grep -qx "$WINDOW_ID"; then
  # exists and is visible -> hide it
  xdotool windowunmap "$WINDOW_ID"

else
  # exists but is hidden -> show and focus
  xdotool windowmap "$WINDOW_ID"
  xdotool windowactivate "$WINDOW_ID"

fi
